# LLM: any OpenAI-compatible endpoint with a vision model. Leave LLM_BASE_URL empty for OpenAI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_MOCK=1   # no LLM calls: keyword heuristics only (useful if the API is down during the demo)

# Telegram alerts (create a bot with @BotFather; get the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reputation sources (all free tiers; leave empty to skip)
GSB_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
URLSCAN_API_KEY=

# Links inside alerts must open on the phone: use the laptop's LAN address
PUBLIC_BASE_URL=http://192.168.1.20
RAQIB_SECRET=change-me

# Demo domains that exist only inside Raqib (point them at the laptop's LAN IP)
HOST_MAP=adpolice-fines-pay.com=192.168.1.20,uae-fines-portal.com=192.168.1.20,iphone-mega-sale.com=192.168.1.20,dubai-events-guide.com=192.168.1.20

# Guard
UPSTREAM=1.1.1.1
BLOCK_SCORE=0.7
SCAN_SCORE=0.25
